# Google Scholar search through SerpApi
SERPAPI_API_KEY=replace_with_your_key
# Optional: your SerpApi plan cost divided by included searches
# SERPAPI_COST_PER_REQUEST_USD=0.01

# Local dense embedding model. It is downloaded once and cached under data/models.
# PAPER_PULSE_EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
# PAPER_PULSE_MODEL_CACHE=/absolute/path/to/model-cache
# If huggingface.co is unavailable in your network:
# PAPER_PULSE_MODEL_HOST=https://hf-mirror.com

# Optional local overrides
# HOST=127.0.0.1
# PORT=3220
# PAPER_PULSE_DB=/absolute/path/to/paper-pulse.db
# PAPER_PULSE_TRACE_PATH=/absolute/path/to/traces.jsonl
